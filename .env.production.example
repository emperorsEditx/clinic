# Copy to /opt/apps/clinic/.env on the VPS (chmod 600). Read by docker-compose.prod.yml.
# Generate APP_KEY locally with:  php artisan key:generate --show

APP_NAME="Clinic Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinic.example.com
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Shared MySQL container on the same Docker network (use its container/service name)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clinic
DB_USERNAME=clinic
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CLINIC_NAME="My Clinic"
ADMIN_NAME="Clinic Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
LAB_REPORT_MAX_KB=10240

BACKUP_ENABLED=true
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=

# --- docker compose (not used by Laravel) ---
# External Docker network shared with MySQL and the SSL proxy
DOCKER_NETWORK=web
# Host port bound to 127.0.0.1 for a host-level reverse proxy
APP_PORT=8090
# Public domain (used by nginx-proxy/acme-companion setups)
CLINIC_DOMAIN=clinic.example.com
